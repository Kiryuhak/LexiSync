{
    "name": "lexisync-extension",
    "version": "2.19.0",
    "description": "Умный помощник для работы с текстом на базе Mistral AI",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "npm run build:chrome && npm run build:firefox",
        "build:chrome": "wxt build -c scripts/wxt-release.config.ts -b chrome",
        "build:firefox": "wxt build -c scripts/wxt-release.config.ts -b firefox",
        "zip": "npm run zip:chrome && npm run zip:firefox",
        "zip:chrome": "wxt zip -c scripts/wxt-release.config.ts -b chrome",
        "zip:firefox": "wxt zip -c scripts/wxt-release.config.ts -b firefox",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:i18n": "node scripts/check-i18n.mjs",
        "audit:dependencies": "npm audit --audit-level=high",
        "verify:manifests": "node scripts/verify-production-manifests.mjs",
        "verify:artifacts": "npm run verify:manifests && node scripts/verify-release-artifacts.mjs",
        "test:unit": "vitest run --configLoader runner",
        "test:coverage": "vitest run --configLoader runner --coverage",
        "build:e2e": "node scripts/build-e2e.mjs",
        "build:e2e:firefox": "node scripts/build-firefox-e2e.mjs",
        "test:e2e:only": "playwright test tests/e2e.spec.ts",
        "test:e2e": "npm run build:e2e && npm run test:e2e:only",
        "test:firefox:only": "playwright test tests/firefox.spec.ts",
        "test:firefox": "npm run build:e2e:firefox && npm run test:firefox:only",
        "test:runtime": "npm run build:e2e && npm run test:e2e:only && npm run test:firefox:only",
        "lint:firefox": "web-ext lint --source-dir .output/release/firefox-mv3",
        "check:static": "npm run format:check && npm run lint && npm run typecheck && npm run check:i18n",
        "verify:release": "npm run zip && npm run verify:artifacts && npm run lint:firefox",
        "verify": "npm run check:static && npm run audit:dependencies && npm run test:coverage && npm run verify:release",
        "test:all": "npm run verify && npm run test:runtime",
        "postinstall": "wxt prepare"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Kiryuhak/LexiSync.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/Kiryuhak/LexiSync/issues"
    },
    "homepage": "https://github.com/Kiryuhak/LexiSync#readme",
    "overrides": {
        "shell-quote": "^1.8.4",
        "tmp": "^0.2.6"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@eslint/js": "^9.39.4",
        "@playwright/test": "^1.61.1",
        "@types/chrome": "^0.2.0",
        "@types/node": "^26.1.0",
        "@vitest/coverage-v8": "^3.2.6",
        "eslint": "^9.39.4",
        "globals": "^16.4.0",
        "prettier": "^3.6.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.46.0",
        "vitest": "^3.2.6",
        "web-ext": "^10.3.0",
        "wxt": "^0.20.27"
    }
}
